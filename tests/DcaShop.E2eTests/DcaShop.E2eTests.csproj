<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- a run that executed no browser test fails -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/e2e.runsettings</RunSettingsFilePath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Same Playwright release as the Java sample's suite, so both drive the same browser builds. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageReference Include="WireMock.Net" Version="2.18.0" />
    <!-- the suite starts the shop itself, in the test process, on a free port -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="$(TestcontainersVersion)" />
    <ProjectReference Include="../../src/DcaShop.Web/DcaShop.Web.csproj" />
    <!-- the shop on a database of its own, shared with the other suite that starts a shop -->
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
    <Using Include="DcaShop.TestSupport" />
  </ItemGroup>
</Project>

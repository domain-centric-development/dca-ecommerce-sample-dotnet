{
  "request": {
    "method": "POST",
    "urlPath": "/payments",
    "bodyPatterns": [
      {
        "equalToJson": {
          "amount": "${json-unit.regex}^[0-9]+\\.[0-9]{2}$",
          "currency": "${json-unit.regex}^[A-Z]{3}$",
          "merchantReference": "${json-unit.regex}^.+$"
        },
        "enablePlaceholders": true
      }
    ]
  },
  "response": {
    "status": 402,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "error": "refused"
    }
  }
}

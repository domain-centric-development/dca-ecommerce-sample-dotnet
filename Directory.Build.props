<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- The DomainCentric.* packages come from NuGet.org. Working on unreleased rules or markers:
         `dotnet test -p:UseLocalDcaDotnet=true` references the sibling checkout ../dca-dotnet as projects
         instead - the counterpart of the Java sample's `-PwithDcaJava`. -->
    <DcaDotnetDir>$(MSBuildThisFileDirectory)../dca-dotnet/src/</DcaDotnetDir>
    <UseLocalDcaDotnet Condition="'$(UseLocalDcaDotnet)' == ''">false</UseLocalDcaDotnet>
    <!-- Optional shared sample specification check (local only, not part of the build): -p:SpecificationPath=../dca-sample-specification -->
    <SpecificationRoot>$(MSBuildThisFileDirectory)build/specification/$(MSBuildProjectName)/</SpecificationRoot>
    <DcaBuildingBlocksVersion>0.3.0</DcaBuildingBlocksVersion>
    <DcaArchRulesVersion>0.13.0</DcaArchRulesVersion>
    <!-- A closed use-case result (WP-171): OneOf until C# 15 unions are released for the .NET the samples run on. -->
    <OneOfVersion>3.0.271</OneOfVersion>
    <!-- PostgreSQL in every store (WP-120): Npgsql + Dapper in the adapters, DbUp for the migrations,
         Testcontainers in the tests. -->
    <NpgsqlVersion>10.0.3</NpgsqlVersion>
    <DapperVersion>2.1.89</DapperVersion>
    <DbUpPostgresqlVersion>7.0.1</DbUpPostgresqlVersion>
    <TestcontainersVersion>4.16.0</TestcontainersVersion>
  </PropertyGroup>
</Project>

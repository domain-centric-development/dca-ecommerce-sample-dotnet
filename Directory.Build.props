<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- The DomainCentric.* packages come from NuGet.org. Working on unreleased rules or markers:
         `dotnet test -p:UseLocalDcaDotnet=true` references the sibling checkout ../dca-dotnet as projects
         instead - the counterpart of the Java sample's `-PwithDcaJava`. -->
    <DcaDotnetDir>$(MSBuildThisFileDirectory)../dca-dotnet/src/</DcaDotnetDir>
    <UseLocalDcaDotnet Condition="'$(UseLocalDcaDotnet)' == ''">false</UseLocalDcaDotnet>
    <!-- Shared specification review commit; use the local path override until publication. -->
    <SpecificationRevision>1e6be664a8535ad604b3686daf9e9ea2d0b02b59</SpecificationRevision>
    <SpecificationRoot>$(MSBuildThisFileDirectory)build/specification/$(MSBuildProjectName)/</SpecificationRoot>
    <DcaBuildingBlocksVersion>0.1.0</DcaBuildingBlocksVersion>
    <DcaArchRulesVersion>0.3.0</DcaArchRulesVersion>
  </PropertyGroup>
</Project>

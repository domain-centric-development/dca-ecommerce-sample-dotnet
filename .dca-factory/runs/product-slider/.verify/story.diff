@@ -0,0 +1,54 @@
+@model DcaShop.Product.Adapter.Incoming.Web.ProductSliderViewModel
+<section class="section product-slider" data-test="product-slider" aria-labelledby="product-slider-title">
+<h2 class="section__title" id="product-slider-title" data-test="product-slider-title">Discover products</h2>
+<div class="product-slider__controls">
+<button class="btn btn--ghost product-slider__button" type="button" data-test="product-slider-previous" data-product-slider-previous>Previous</button>
+<button class="btn btn--ghost product-slider__button" type="button" data-test="product-slider-next" data-product-slider-next>Next</button>
+</div>
+<div class="product-slider__track" data-product-slider-track>
+@foreach (var card in Model.Cards)
+{
+<article class="product-slider__card" data-test="product-slider-card">
+<a class="product-slider__link" href="/products/@card.ProductId" data-test="product-slider-card-link">
+<div class="product-slider__image">
+@if (!string.IsNullOrEmpty(card.ImageUrl))
+{
+<img src="@card.ImageUrl" alt="@card.Name" data-test="product-slider-card-image">
+}
+else
+{
+<div class="product-card__image-placeholder" data-test="product-slider-card-image">@card.Name[0]</div>
+}
+</div>
+<h3 class="product-slider__name" data-test="product-slider-card-name">@card.Name</h3>
+<div class="product-slider__price" data-test="product-slider-card-price">@card.Price</div>
+</a>
+</article>
+}
+</div>
+<script>
+(function () {
+  var slider = document.currentScript.parentElement;
+  var track = slider.querySelector('[data-product-slider-track]');
+  var previous = slider.querySelector('[data-product-slider-previous]');
+  var next = slider.querySelector('[data-product-slider-next]');
+  function step() {
+    var cards = track.children;
+    return cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth;
+  }
+  function update() {
+    previous.disabled = track.scrollLeft <= 1;
+    next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
+  }
+  function move(by) {
+    var index = Math.round(track.scrollLeft / step()) + by;
+    track.scrollTo({ left: Math.max(0, index) * step() });
+  }
+  previous.addEventListener('click', function () { move(-1); });
+  next.addEventListener('click', function () { move(1); });
+  track.addEventListener('scroll', update, { passive: true });
+  window.addEventListener('resize', update);
+  update();
+})();
+</script>
+</section>

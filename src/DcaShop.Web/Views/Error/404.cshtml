@{ ViewData["Title"] = "Page Not Found"; }
<div class="error-page">
<div class="error-page__code">404</div>
<h2 class="error-page__title">Page Not Found</h2>
<p class="error-page__message">The page you're looking for doesn't exist or has been removed.
Perhaps you were looking for one of our products?</p>
<div class="error-page__action">
<a class="btn btn--accent" href="/products" data-test="error-browse-link">Browse All Products</a>
<a class="btn btn--secondary" href="/" data-test="error-home-link">Go to Homepage</a>
</div>
</div>

@{ ViewData["Title"] = "DCA Commerce"; }
<section class="hero" data-test="hero">
<h1 class="hero__title">Welcome to DCA Commerce</h1>
<p class="hero__subtitle">Discover our curated collection of premium products</p>
<p class="hero__description">Shop with confidence. We bring you quality products with fast delivery, secure payments, and hassle-free returns.</p>
<div class="hero__actions">
<a class="hero__cta hero__cta--primary" href="/products" data-test="browse-products-link">Browse Products</a>
<a class="hero__cta hero__cta--secondary" href="/cart" data-test="view-cart-link">View Cart</a>
</div>
</section>
<section class="section" data-test="features">
<h2 class="section__title">Why Shop With Us</h2>
<div class="feature-grid">
<div class="feature-card"><span class="feature-card__icon">&#10140;</span><h3 class="feature-card__title">Free Shipping</h3><p class="feature-card__description">Enjoy free shipping on all orders over $50. Fast and reliable delivery straight to your door.</p></div>
<div class="feature-card"><span class="feature-card__icon">&#9670;</span><h3 class="feature-card__title">Secure Payments</h3><p class="feature-card__description">Your transactions are protected with industry-leading encryption and fraud prevention.</p></div>
<div class="feature-card"><span class="feature-card__icon">&#10022;</span><h3 class="feature-card__title">Quality Products</h3><p class="feature-card__description">Every item in our catalog is carefully selected and quality-tested before listing.</p></div>
<div class="feature-card"><span class="feature-card__icon">&#8635;</span><h3 class="feature-card__title">Easy Returns</h3><p class="feature-card__description">Not satisfied? Return any item within 30 days for a full refund, no questions asked.</p></div>
</div>
</section>
<section class="section section--muted" data-test="categories">
<h2 class="section__title">Popular Categories</h2>
<div class="highlight-grid">
<div class="highlight-card"><span class="highlight-card__title">Electronics</span><p class="highlight-card__description">Latest gadgets, accessories, and tech essentials for everyday life.</p></div>
<div class="highlight-card"><span class="highlight-card__title">Home &amp; Living</span><p class="highlight-card__description">Furniture, decor, and everything you need to make your house a home.</p></div>
<div class="highlight-card"><span class="highlight-card__title">Fashion</span><p class="highlight-card__description">Trendy clothing, footwear, and accessories for every occasion.</p></div>
<div class="highlight-card"><span class="highlight-card__title">Sports &amp; Outdoors</span><p class="highlight-card__description">Gear up for your next adventure with our outdoor and fitness collection.</p></div>
</div>
</section>
<section class="section" data-test="cta-section">
<div class="hero" data-test="cta-banner">
<h2 class="hero__title">Ready to Start Shopping?</h2>
<p class="hero__subtitle">Browse our full catalog and find something you love.</p>
<div class="hero__actions"><a class="hero__cta hero__cta--primary" href="/products" data-test="shop-now-link">Shop Now</a></div>
</div>
</section>

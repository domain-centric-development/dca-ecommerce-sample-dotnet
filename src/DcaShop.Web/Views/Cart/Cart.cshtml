@model DcaShop.Cart.Adapter.Incoming.Web.CartPageViewModel
@{ ViewData["Title"] = "Your cart"; }
<h1>Your cart</h1>
@if (Model.Items.Count == 0)
{
    <p data-test="cart-empty">Your cart is empty. <a href="/products">Browse products</a>.</p>
}
else
{
    @if (Model.HasPriceChanges)
    {
        <p class="error">Some prices changed since you added the items.</p>
    }
    <table>
        <thead><tr><th>Product</th><th>Unit price</th><th>Quantity</th><th>Total</th><th></th></tr></thead>
        <tbody>
        @foreach (var line in Model.Items)
        {
            <tr data-test="cart-line">
                <td><a href="/products/@line.ProductId">@line.Name</a> @if (!line.InStock) { <span class="badge">insufficient stock</span> }</td>
                <td>@line.UnitPrice</td>
                <td data-test="cart-line-quantity">@line.Quantity</td>
                <td>@line.LineTotal</td>
                <td>
                    <form method="post" action="/cart/items/@line.ItemId/remove">
    @Html.AntiForgeryToken()
                        <button type="submit" class="secondary" data-test="remove-item">Remove</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="3">Subtotal</th><th data-test="cart-subtotal">@Model.Subtotal</th><th></th></tr></tfoot>
    </table>
    <p>
        <a href="/products" class="button secondary">Continue shopping</a>
        @if (Model.CanCheckout)
        {
            <form method="post" action="/checkout/start" style="display:inline">
    @Html.AntiForgeryToken()
                <input type="hidden" name="cartId" value="@Model.CartId" />
                <button type="submit" data-test="start-checkout">Checkout</button>
            </form>
        }
    </p>
}

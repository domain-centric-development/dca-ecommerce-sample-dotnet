@model DcaShop.Account.Adapter.Incoming.Web.ChangePasswordPageViewModel
@{ ViewData["Title"] = "Change Password"; }
<div class="account" data-test="change-password-page">
<div class="account__header">
<h2 class="account__title" data-test="change-password-title">Change Password</h2>
</div>
<div class="account__layout">
@await Html.PartialAsync("~/Views/Account/_Nav.cshtml", Model.NavItems)
<div class="account__content">
@if (Model.SuccessMessage is { } success)
{
<div class="alert alert--success" data-test="change-password-success-message">@success</div>
}
@if (Model.ErrorMessage is { } error)
{
<div class="alert alert--error" data-test="change-password-error-message">@error</div>
}
<div class="card">
<div class="card__body">
<form class="form" method="POST" action="/account/change-password" data-test="change-password-form">
@Html.AntiForgeryToken()
<div class="form__group">
<label class="form__label" for="currentPassword">Current Password</label>
<input class="form__input" id="currentPassword" type="password" name="currentPassword" required autofocus placeholder="Your current password" data-test="change-password-current-password-input">
</div>
<div class="form__group">
<label class="form__label" for="newPassword">New Password</label>
<input class="form__input" id="newPassword" type="password" name="newPassword" required minlength="8" maxlength="72" placeholder="Your new password" data-test="change-password-new-password-input">
<p class="form__hint">Password must be at least 8 characters and contain an uppercase letter, a lowercase letter and a digit</p>
</div>
<div class="form__group">
<label class="form__label" for="confirmPassword">Confirm New Password</label>
<input class="form__input" id="confirmPassword" type="password" name="confirmPassword" required maxlength="72" placeholder="Repeat your new password" data-test="change-password-confirm-password-input">
</div>
<div class="form__actions">
<button class="btn btn--primary" type="submit" data-test="change-password-submit-button">Change Password</button>
</div>
</form>
</div>
</div>
</div>
</div>
</div>

@model DcaShop.Account.Adapter.Incoming.Web.ProfilePageViewModel
@{ ViewData["Title"] = "My Profile"; }
<div class="account" data-test="profile-page">
<div class="account__header">
<h2 class="account__title" data-test="profile-title">My Profile</h2>
</div>
<div class="account__layout">
@await Html.PartialAsync("~/Views/Account/_Nav.cshtml", Model.NavItems)
<div class="account__content">
@if (Model.SuccessMessage is { } success)
{
<div class="alert alert--success" data-test="profile-success-message">@success</div>
}
@if (Model.ErrorMessage is { } error)
{
<div class="alert alert--error" data-test="profile-error-message">@error</div>
}
<div class="card">
<div class="card__header"><h3 class="card__header-title">Basic Information</h3></div>
<div class="card__body">
<div class="form__group">
<span class="form__label">Name</span>
<p data-test="profile-owner-name">@Model.FullName</p>
<p class="form__hint" data-test="profile-name-note">Your name was set when you created your account and cannot be changed.</p>
</div>
<form class="form" method="POST" action="/account/profile" data-test="profile-form">
@Html.AntiForgeryToken()
<div class="form__group">
<label class="form__label" for="email">Email</label>
<input class="form__input" id="email" type="email" name="email" required autofocus placeholder="you@example.com" value="@Model.Email" data-test="profile-email-input">
<p class="form__hint">This address is also your login</p>
</div>
<div class="form__group">
<label class="form__label" for="dateOfBirth">Date of Birth</label>
<input class="form__input" id="dateOfBirth" type="date" name="dateOfBirth" required value="@Model.DateOfBirth" data-test="profile-date-of-birth-input">
</div>
<div class="form__actions">
<button class="btn btn--primary" type="submit" data-test="profile-submit-button">Save Changes</button>
</div>
</form>
</div>
</div>
</div>
</div>
</div>

@inject DcaShop.SharedKernel.Application.Shared.IIdentityProvider IdentityProvider
@{ var identity = IdentityProvider.GetCurrentIdentity(); }
<!DOCTYPE html>
<html lang="en">
<head>
<partial name="_SiteHead" />
</head>
<body>
<div class="stack-ribbon stack-ribbon--dotnet" aria-hidden="true" data-test="stack-ribbon">
<span class="stack-ribbon__label" title=".NET reference implementation — ASP.NET Core">.NET</span>
</div>
<header class="site-header" data-test="site-header">
<div class="site-header__inner">
<a class="site-header__logo" href="/" data-test="site-logo"><svg class="site-header__mark" viewBox="17.4 12 85.2 96" fill="none" aria-hidden="true" focusable="false"><polygon points="60,20 94.6,40 94.6,80 60,100 25.4,80 25.4,40" stroke="currentColor" stroke-width="7" stroke-linejoin="round"/><circle cx="60" cy="20" r="8" fill="currentColor"/><circle cx="94.6" cy="40" r="8" fill="currentColor"/><circle cx="94.6" cy="80" r="8" fill="currentColor"/><circle cx="60" cy="100" r="8" fill="currentColor"/><circle cx="25.4" cy="80" r="8" fill="currentColor"/><circle cx="25.4" cy="40" r="8" fill="currentColor"/><circle class="site-header__mark-core" cx="60" cy="60" r="12"/></svg><span class="site-header__wordmark">domaincentric<span class="brand-tld">.commerce</span></span></a>
<nav class="nav" aria-label="Main navigation">
<ul class="nav__list">
<li class="nav__item"><a class="nav__link" href="/" data-test="nav-home-link">Home</a></li>
<li class="nav__item"><a class="nav__link" href="/products" data-test="nav-products-link">Products</a></li>
</ul>
</nav>
<div class="site-header__actions">
@if (identity.IsRegistered)
{
<a class="nav__link" href="/account" data-test="nav-my-account-link">My Account</a>
}
@await Component.InvokeAsync("MiniBasket")
@if (identity.IsRegistered)
{
<span class="nav__link" data-test="user-greeting">Welcome, @(identity.Email ?? "User")</span>
<form class="nav__logout-form" method="post" action="/logout" data-test="logout-form">
@Html.AntiForgeryToken()
<button class="nav__link nav__logout-btn" type="submit" data-test="logout-button">Logout</button>
</form>
}
else
{
<a class="nav__link" href="/login" data-test="nav-login-link">Login</a>
<a class="nav__link" href="/register" data-test="nav-register-link">Register</a>
}
</div>
</div>
</header>
<main class="site-main">
<div class="container">
@await Component.InvokeAsync("AccountNotice")
@RenderBody()
</div>
</main>
<partial name="_SiteFooter" />
@RenderSection("Scripts", required: false)
</body>
</html>

@model DcaShop.Checkout.Adapter.Incoming.Web.CheckoutPageViewModel
<table>
    <thead><tr><th>Product</th><th>Unit price</th><th>Qty</th><th>Total</th></tr></thead>
    <tbody>
    @foreach (var line in Model.Session.LineItems)
    {
        <tr data-test="checkout-line"><td>@line.ProductName</td><td>@line.UnitPrice</td><td>@line.Quantity</td><td>@line.LineTotal</td></tr>
    }
    </tbody>
    <tfoot>
        <tr><th colspan="3">Subtotal</th><td>@Model.Session.Subtotal</td></tr>
        <tr><th colspan="3">Shipping</th><td>@Model.Session.Shipping</td></tr>
        <tr><th colspan="3">Total</th><td data-test="checkout-total">@Model.Session.Total</td></tr>
    </tfoot>
</table>

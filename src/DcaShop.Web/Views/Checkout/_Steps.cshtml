@model DcaShop.Checkout.Adapter.Incoming.Web.CheckoutPageViewModel
@{
    var steps = new[] { ("BuyerInfo", "1. Buyer"), ("Delivery", "2. Delivery"), ("Payment", "3. Payment"), ("Review", "4. Review"), ("Confirmation", "5. Confirmation") };
}
<div class="steps">
@foreach (var (key, label) in steps)
{
    <span class="@(Model.IsStep(key) ? "current" : "")">@label</span>
}
</div>
@if (Model.Error is not null)
{
    <p class="error" data-test="error">@Model.Error</p>
}

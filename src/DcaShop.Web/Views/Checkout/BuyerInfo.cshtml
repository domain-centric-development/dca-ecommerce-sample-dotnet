@model DcaShop.Checkout.Adapter.Incoming.Web.CheckoutPageViewModel
@{ ViewData["Title"] = "Checkout – Buyer"; var b = Model.Session.BuyerInfo; }
<h1>Who is buying?</h1>
<partial name="~/Views/Checkout/_Steps.cshtml" model="Model" />
<form method="post" action="/checkout/@Model.Session.SessionId/buyer-info" class="card">
    @Html.AntiForgeryToken()
    <label for="email">Email</label><input type="email" id="email" name="email" value="@b?.Email" required data-test="email" />
    <label for="firstName">First name</label><input type="text" id="firstName" name="firstName" value="@b?.FirstName" required data-test="first-name" />
    <label for="lastName">Last name</label><input type="text" id="lastName" name="lastName" value="@b?.LastName" required data-test="last-name" />
    <label for="phone">Phone</label><input type="tel" id="phone" name="phone" value="@b?.Phone" required data-test="phone" />
    <p><button type="submit" data-test="continue">Continue to delivery</button></p>
</form>

@model DcaShop.Checkout.Adapter.Incoming.Web.CheckoutPageViewModel
@{ ViewData["Title"] = "Order Confirmed"; var s = Model.Session; }
<div class="confirmation">
@await Html.PartialAsync("~/Views/Checkout/_Progress.cshtml", 5)
<div class="confirmation__message" data-test="confirmation-message">
<div class="confirmation__icon"></div>
<h3 class="confirmation__title" data-test="confirmation-title">Your order has been placed successfully</h3>
<p class="confirmation__reference">Order Reference: @s.SessionId</p>
</div>
<div class="confirmation__details">
<h3 class="confirmation__details-title">Order Summary</h3>
@if (s.BuyerInfo is { } b)
{
<div class="confirmation__detail-section"><h4>Contact Information</h4><p>@b.FirstName @b.LastName</p><p>@b.Email</p><p>@b.Phone</p></div>
}
@if (s.DeliveryAddress is { } a && s.ShippingOption is { } o)
{
<div class="confirmation__detail-section">
<h4>Delivery Address</h4>
<p>@a.Street</p>
@if (a.StreetLine2 is not null) {<p>@a.StreetLine2</p>}
<p>@a.City, @a.PostalCode</p>
@if (a.State is not null) {<p>@a.State, @a.Country</p>} else {<p>@a.Country</p>}
<h4>Shipping Method</h4>
<p>@o.Name</p>
<p>Estimated Delivery: @o.EstimatedDelivery</p>
</div>
}
@if (s.PaymentSelection is { } p)
{
<div class="confirmation__detail-section"><h4>Payment Method</h4><p>@p.ProviderId.Value</p></div>
}
@if (s.LineItems.Count > 0)
{
<div class="confirmation__detail-section">
<h4>Items Ordered</h4>
@foreach (var item in s.LineItems)
{
<div class="order-summary__item">
<div class="order-summary__item-image">@if (!string.IsNullOrEmpty(item.ImageUrl)) {<img src="@item.ImageUrl" alt="@item.Name">}</div>
<span class="order-summary__item-name">@item.Name</span>
<span class="order-summary__item-qty">x@(item.Quantity)</span>
<span class="order-summary__item-price">@item.LineTotal</span>
</div>
}
</div>
}
<div class="confirmation__detail-section">
<div class="order-summary__line"><span>Subtotal</span><span>@s.Subtotal</span></div>
@if (s.ShippingOption is not null) {<div class="order-summary__line"><span>Shipping</span><span>@s.Totals.Shipping</span></div>}
<div class="order-summary__total"><span>Total Paid</span><span>@s.Totals.Total</span></div>
</div>
</div>
<div class="confirmation__next-steps">
<p>We've sent a confirmation email to @(s.BuyerInfo?.Email ?? "your email address").</p>
<p>You can track your order status using your order reference.</p>
</div>
<div class="confirmation__footer"><a class="btn btn--primary btn--lg" href="/" data-test="confirmation-continue-link">Continue Shopping</a></div>
</div>

@model DcaShop.Product.Adapter.Incoming.Web.ProductDetailPageViewModel
@{ ViewData["Title"] = Model.Name; }
<p><a href="/products">← Back to catalog</a></p>
<div class="card">
    <img src="@Model.ImageUrl" alt="@Model.Name" style="max-width: 400px" />
    <h1 data-test="product-name">@Model.Name</h1>
    <p class="muted">@Model.Category · SKU @Model.Sku</p>
    <p>@Model.Description</p>
    <p class="price" data-test="product-price">@Model.Price</p>
    <p class="muted">@Model.AvailableStock in stock</p>
    @if (Model.CanBePurchased)
    {
        <form method="post" action="/cart/items">
            <input type="hidden" name="productId" value="@Model.ProductId" />
            <label for="quantity">Quantity</label>
            <input type="number" id="quantity" name="quantity" value="1" min="1" max="@Model.AvailableStock" />
            <button type="submit" data-test="add-to-cart">Add to cart</button>
        </form>
    }
    else
    {
        <span class="badge">Out of stock</span>
    }
</div>

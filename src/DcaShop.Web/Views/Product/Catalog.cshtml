@model DcaShop.Product.Adapter.Incoming.Web.ProductCatalogPageViewModel
@{ ViewData["Title"] = "Products"; }
<div class="breadcrumb" data-test="breadcrumb">
<a class="breadcrumb__link" href="/">Home</a>
<span class="breadcrumb__separator">/</span>
<span class="breadcrumb__current">Products</span>
</div>
<h1>Our Products</h1>
@if (Model.Products.Count > 0)
{
<div class="product-grid" data-test="product-grid">
@foreach (var product in Model.Products)
{
<div class="product-card" data-test="product-card">
<div class="product-card__image" style="view-transition-name: product-img-@product.ProductId">
@if (!string.IsNullOrEmpty(product.ImageUrl))
{
<img src="@product.ImageUrl" alt="@product.Name">
}
else
{
<div class="product-card__image-placeholder">@product.Name[0]</div>
}
</div>
<div class="product-card__body">
<h3 class="product-card__title">@product.Name</h3>
@if (!string.IsNullOrEmpty(product.Description))
{
<p class="product-card__description">@product.Description</p>
}
<div class="product-card__price">@product.Price</div>
<div class="product-card__footer">
@if (product.CanBePurchased)
{
<span class="product-card__badge product-card__badge--available">In Stock</span>
}
else
{
<span class="product-card__badge product-card__badge--out-of-stock">Out of Stock</span>
}
<a class="product-card__action" href="/products/@product.ProductId" data-test="view-product">View Details</a>
</div>
</div>
</div>
}
</div>
}
else
{
<div class="empty-state">
<p class="empty-state__title">No products available</p>
<p class="empty-state__message">Check back soon for new products.</p>
</div>
}

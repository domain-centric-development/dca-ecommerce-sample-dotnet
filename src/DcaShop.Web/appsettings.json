{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Shop": "Host=localhost;Port=5433;Database=shop;Username=shop;Password=shop"
  },
  "DataProtection": {
    "ApplicationName": "dca-shop",
    "KeysDirectory": ""
  },
  "Backoffice": {
    "Username": "admin",
    "Password": "admin",
    "SecureCookies": false
  },
  "Jwt": {
    "Secret": "dca-shop-sample-development-secret-key-32+",
    "Issuer": "dca-ecommerce-sample",
    "AnonymousExpirationDays": 30,
    "RegisteredExpirationDays": 7,
    "IdentityCookieName": "shop-identity",
    "SessionCookieName": "shop-session",
    "SecureCookies": false,
    "SameSite": "Lax",
    "AllowFraming": true
  }
}
